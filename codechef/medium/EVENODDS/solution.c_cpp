#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>a(n);
       int odd_count = 0;
    int first_odd = -1;
    int last_odd = -1;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        if (a[i] % 2 != 0) {
            odd_count++;
            if (first_odd == -1) {
                first_odd = i;
            }
            last_odd = i;
        }
    }

  
    if (odd_count % 2 == 0) {
        cout << n << "\n";
    } else {
       
        int option1 = n - (first_odd + 1);
        int option2 = last_odd;
        cout << max(option1, option2) << "\n";    }
}
