#include <iostream>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int a[n];
        int total=0;
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
            total+=a[i];
        }
        int pair=a[0]+a[1];
        for(int i=1;i<n-1;i++)
        {
            pair=min(pair,a[i]+a[i+1]);
            }
            cout<<total-pair/2<<endl;
    }
}
