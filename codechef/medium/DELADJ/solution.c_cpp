#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n;
    cin>>n;
    
    vector<long long> a(n + 1);
    long long ans = 0;
    for (int i = 1; i <= n; i++) {
        cin >> a[i];
        ans -= a[i];
    }

    priority_queue<long long> pq;
    pq.push(a[1]);
    ans += 2 * pq.top();
    pq.pop();

    for (int i = 3; i <= n; i += 2) {
        pq.push(a[i - 1]);
        pq.push(a[i]);
        ans += 2 * pq.top();
        pq.pop();
    }

    cout << ans << "\n";
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
