#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n,s;
    cin>>n>>s;
    if(s>n*4)
    {
        cout<<-1<<"\n";
        return;    }
        long long c=(s>=0)?(s+3)/4:0;
        long long w=4*c-s;
        long long attempt=c+w;
        if (attempt<=n)
        {
            cout<<attempt<<endl;
        }
        else
        cout<<-1<<endl;
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
