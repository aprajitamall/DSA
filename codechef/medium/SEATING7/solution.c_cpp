#include <bits//stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,m,k;
        cin>>n>>m>>k;
        vector<int>oc(n+1,0);
        for(int i=0;i<m;i++)
        {
            int val;
            cin>>val;
            oc[val]=1;
        }
        int c_s=1;
        for(int i=0;i<k;i++)
        {
            while(oc[c_s]==1)
            {
                c_s++;
            }
            cout<<c_s<<" ";
            oc[c_s]=1;
        }
        cout<<"\n";
    }
}
