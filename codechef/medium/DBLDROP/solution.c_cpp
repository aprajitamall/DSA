#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int N;
    cin>>N;
   vector<long long> A(N);
    long long sum = 0;
    long long m1 = 0;

    for (int i = 0; i < N; ++i) {
        cin >> A[i];
        sum += A[i];
        m1 = max(m1, A[i]);
    }

    
    long long ans = sum - m1;

 
    for (int i = 0; i < N; ++i) {
        long long new_sum = sum + A[i];
        long long new_max = max(m1, 2 * A[i]);
        ans = max(ans, new_sum - new_max);
    }

    cout << ans << "\n";
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
