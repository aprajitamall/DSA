#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n;
    cin>>n;
    long long sum=0;
    long long m1=0,m2=0;
    for(int i=0;i<n;i++)
    {
        long long x;
        cin>>x;
        sum+=x;
         if (x >= m1) {
            m2 = m1;
            m1 = x;
        } else if (x > m2) {
            m2 = x;
        }
    }

    long long ans = sum + m2 - max(m1, 2 * m2);
    cout << ans << "\n";

}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
