#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,d;
        cin>>n>>d;
        vector<int>a(n);
        vector<int>b(n);
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
        }
        for(int i=0;i<n;i++)
        {
            cin>>b[i];
        }
        int c_1=d;
        int c_2=d;
        int c_both=2*d;
        for(int i=0;i<n;i++)
        {
            c_1+=a[i];
            c_2+=b[i];
            c_both+=min(a[i],b[i]);
        
        }
        int ans=min({c_1,c_2,c_both});
        cout<<ans<<endl;
    }
}
