#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n;
    cin>>n;
    vector<int> a(n);
    vector<bool> present(n + 1, false);
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
        present[a[i]]=true;
    }
    bool is_pl=true;
    for(int i=0;i<n/2;i++)
    {
        if(a[i]!=a[n-1-i])
        {
            is_pl=false;
            break;
        }
    }
    if(is_pl)
    {
        cout<<"no\n";
        return;
    }
    for (int x = 1; x <= n; ++x) {
        if (!present[x]) {
            cout << "YES " << x << "\n";
            return;
        }
    }
cout<<"yes 1\n";
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
