
#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    vector<long long> a(n + 1);
    for (int i = 1; i <= n; i++) {
        cin >> a[i];
    }

    vector<long long> diff(n + 2, 0);
    long long added_stones = 0;
    long long total_moved = 0;

    for (int i = 1; i <= n; i++) {
        added_stones += diff[i];
        long long current_stones = a[i] + added_stones;

        long long x = min(current_stones, (long long)(n - i));
        total_moved += x;

        if (x > 0) {
            diff[i + 1] += 1;
            diff[i + x + 1] -= 1;
        }
    }

    cout << total_moved << "\n";
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
