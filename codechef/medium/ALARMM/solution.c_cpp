
    
 #include <iostream>
#include <string>
#include <algorithm>

using namespace std;

void solve()
{
    int n, k;
    cin >> n >> k;
    string s;
    cin >> s;
    
    int alarm = 0;
    
    int rightmost_cover = 0; 
    
    for (int i = 1; i <= n; i++)
    {
        if (s[i-1] == '1')
        {
            
            if (i <= rightmost_cover)
            {
                continue;
            }
           
            int p = min(n, i + k);
            
            rightmost_cover = p;
            
            alarm++;
        }
    }
    cout << alarm << "\n";
}

int main()
{
    
    int t;
    if (cin >> t)
    {
        while (t--)
        {
            solve();
        }
    }
    return 0;
}
