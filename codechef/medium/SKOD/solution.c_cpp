#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int a[n];
        long long t_sum=0;
        int min_v=101;
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
            t_sum+=a[i];
            if(a[i]<min_v)
            {
                min_v=a[i];
            }
        }
        cout<<t_sum-min_v<<endl;
    }
}
