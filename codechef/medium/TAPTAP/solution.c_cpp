#include <bits/stdc++.h>
using namespace std;
const int MOD = 998244353;
void solve()
{
    int n,g;
    cin>>n,g;
    vector<long long> a(n + 1);
    for (int i = 1; i <= n; ++i) {
        cin >> a[i];
    }

    for (int i = 3; i <= n; ++i) {
        if (a[i] - a[i - 2] < g) {
            cout << 0 << "\n";
            return;
        }
    }

    vector<long long> dp(n + 1, 0);
    dp[0] = 2;

    long long total_ways = 2;
    long long valid_switch_sum = 2;
    int valid_ptr = 0;

    for (int i = 2; i <= n; ++i) {
        while (valid_ptr + 1 <= i - 2 && a[i] - a[valid_ptr + 1] >= g) {
            valid_ptr++;
            valid_switch_sum = (valid_switch_sum + dp[valid_ptr]) % MOD;
        }

        long long ways_to_switch = valid_switch_sum;

        if (a[i] - a[i - 1] < g) {
            total_ways = ways_to_switch;
            valid_switch_sum = 0;
            valid_ptr = i - 2;
        } else {
            total_ways = (total_ways + ways_to_switch) % MOD;
        }

        dp[i - 1] = ways_to_switch;
    }

    cout << total_ways << "\n";
}


int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
