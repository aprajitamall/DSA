#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n;
    cin>>n;
    int count=0;
    for(int i=0;i<n;i++)
    {
        int val;
        cin>>val;
        if(val==1)
        count++;
    }
    if(n%2!=0)
    cout<<-1<<"\n";
    else
    {
    int target=n/2;
    cout<<abs(count-target)<<endl;
    }
    
}
int main()
{ int t;
cin>>t;
while(t--)
{
    solve();
}
    
}
