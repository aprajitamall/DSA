#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>a(n);
        map<int,int>freq;
        int m_f=0;
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
            int diff=a[i]-i;
            freq[diff]++;
            m_f=max(m_f,freq[diff]);
        }
        cout<<n-m_f<<endl;
    }
}
