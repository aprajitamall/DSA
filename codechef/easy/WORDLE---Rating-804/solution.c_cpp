#include <iostream>
#include <string>

using namespace std;

void solve() {
    string s, t;
    cin >> s >> t;
    
    string m = "";
    for (int i = 0; i < 5; i++) {
        if (s[i] == t[i]) {
            m += 'G';
        } else {
            m += 'B';
        }
    }
    
    cout << m << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}

