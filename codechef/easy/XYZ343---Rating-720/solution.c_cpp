#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int x,y,z;
        cin>>x>>y>>z;
        int maxs=z/y;
        if(maxs>x)
        maxs=x;
        int reduce=x-maxs;
        cout<<reduce<<endl;
        
        
    }
}
