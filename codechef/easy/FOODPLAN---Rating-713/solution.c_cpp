#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,m;
        cin>>n>>m;
        int on=9*n;
        int of=10*m;
        if(on<of)
        cout<<"online\n";
        else if(of<on)
        cout<<"dining\n";
        else
        cout<<"either\n";
    }
}
