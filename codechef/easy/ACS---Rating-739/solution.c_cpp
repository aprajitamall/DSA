#include <bits/stdc++.h>
using  namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int p;
        cin>>p;
        int solved = (p / 100) + (p % 100);
        
        if (solved <= 10) {
            cout << solved << "\n";
        } else {
            cout << -1 << "\n";
        }
    
    }
}
