#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n;
    cin>>n;
   vector<int> freq(n + 1, 0);
    for (int i = 0; i < n; i++) {
        int color;
        cin >> color;
        freq[color]++;
    }
    
    int most_frequent_color = 1;
    int max_count = 0;
    
    
    for (int color = 1; color <= n; color++) {
        if (freq[color] > max_count) {
            max_count = freq[color];
            most_frequent_color = color;
        }
    }
    
    cout << most_frequent_color << "\n";
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
