#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int a[n];
        int sum=0;
        int flag=1;
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
            sum+a[i];
            if(sum/(i+1)<40)
            {
              flag=0;
              break;
            }
        
        }
        if(flag==1)
        cout<<"yes\n";
        else
        cout<<"no\n";
    
    }
}
