#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int a[n];
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
        }
    
    int max_so_far=0;
    for(int i=0;i<n;i++)
    {
      if(a[i]>max_so_far)
      {
      cout<<1<<" ";
      max_so_far=a[i];
      }
      else
      cout<<0<<" ";}
      cout<<endl;
    }
}
