#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n;
    cin>>n;
    vector<int>a(n);
    int sum=0;
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
        sum+=a[i];
    }
    if(sum>=0)
    cout<<0<<"\n";
    else{
    long long target=-sum;
    long long x=(target+n-1)/n;
    cout<<x<<endl;}
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
