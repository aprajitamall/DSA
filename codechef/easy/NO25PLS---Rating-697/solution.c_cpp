#include <bits/stdc++.h>
using namespace std;
bool isImperfect(int m)
{
    if(m<=0)
    return false;
     return (m%2==0||m%5==0)&& !(m%2==0&&m%5==0);
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int min_diff=INT_MAX;
        for(int m=n-2;m<=n+2;m++)
        {
            if(isImperfect(m))
            {
            int  curr_diff=abs(n-m);
            
            min_diff=min(curr_diff,min_diff);
            }
        }
         cout<<min_diff<<endl;
    }
}
