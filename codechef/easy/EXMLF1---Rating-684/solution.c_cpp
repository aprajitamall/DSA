#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int d[n],p[n];
        for(int i=0;i<n;i++)
        {
            
            cin>>d[i]>>p[i];
        }
       int max_s=d[0]/p[0];
       int no=0;
       for(int i=1;i<n;i++)
       {
           if(d[i]/p[i]>max_s)
           {
           max_s=d[i]/p[i];
           no=i;
           }
       }
       cout<<no+1<<endl;
    }
}
