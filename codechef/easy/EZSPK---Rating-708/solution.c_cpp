
#include <bits/stdc++.h>
using namespace std;
bool isvowel(char ch)
{
    return (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u');
}
void solve()
{
    int n;
    cin>>n;
    string s;
    cin>>s;
    int count=0;
    int flag=0;
    
    for(int i=0;i<s.length();i++)
    {
        if(!isvowel(s[i]))
        {
          count++;
          if(count>=4)
          {
             flag=1;
             break;
          }
        }
        else count=0;
    }
    if(flag==1)
    cout<<"yes\n";
    else
    cout<<"no\n";
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}