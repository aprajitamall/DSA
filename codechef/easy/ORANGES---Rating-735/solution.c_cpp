#include <bits/stdc++.h>
using namespace std ;
void solve()
{
    int n, k;
    cin >> n >> k;
    
   
    if (k >= 10 * n && k <= 12 * n) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
