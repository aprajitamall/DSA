#include <bits/stdc++.h>
using namespace std;
bool isVowel(char ch) {
    return (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u');
}
int main() {
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        
    int count = 0;
    bool happy = false;
    
    for (int i = 0; i < s.length(); i++) {
        if (isVowel(s[i])) {
            count++;
            if (count > 2) {
                happy = true;
                break;
            }
        } else {
            count = 0;
        }
    }
      if(happy)
      cout<<"Happy\n";
      else
      cout<<"Sad\n";
    }

}
