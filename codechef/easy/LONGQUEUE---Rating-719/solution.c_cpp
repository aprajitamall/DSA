#include <bits/stdc++.h>
using namespace std;
void solve()
{   
    int n;
    cin>>n;
    vector<int>a(n);
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    int s_wealth=a[n-1];
    int pos=n;
    for(int i=n-2;i>=0;i--)
    {
        if(a[i]<=s_wealth/2)
        pos--;
        else
        break;
    }
    cout<<pos<<"\n";
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
