#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        string s;
        cin>>s;
        bool  carry=true;
        int n=s.length();
        for (int i = n - 1; i >= 0; --i) {
        if (s[i] == '9') {
            s[i] = '0'; // '9' + 1 becomes '0' with a carry
        } else {
            s[i] += 1;  
            carry = false;
            break;
        }
    }
     if (carry) {
        s = "1" + s;
    }
    
    cout << s << "\n";
    }
}
