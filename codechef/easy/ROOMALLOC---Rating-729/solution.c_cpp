#include <iostream>
#include <vector>
#include <cmath>

using namespace std;

void solve() {
    int N;
    cin >> N;
    
    int total_rooms = 0;
    for (int i = 0; i < N; ++i) {
        int A_i;
        cin >> A_i;
       
        total_rooms += (A_i + 1) / 2; 
    }
    
    cout << total_rooms << "\n";
}

int main() {
   
    int T;
    cin >> T;
    while (T--) {
        solve();
    }
    
    return 0;
}

