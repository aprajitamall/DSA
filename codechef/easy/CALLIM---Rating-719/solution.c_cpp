#include <bits/stdc++.h>
using namespace std;
void solve()
{
    int n,k;
    cin>>n>>k;
    int a[n];
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    int sum=0;
    int count=0;
    for(int i=0;i<n;i++)
    {
        if(sum+a[i]<=k)
        {
            sum+=a[i];
            count++;
        }
        else
        {
            break;
        }
        
    }
    cout<<count<<endl;
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
}
